# =====================================================================
# Variables de producción de Centinela Salud (AWS).
# NO se guardan en el repositorio ni en el servidor a mano: cada una es
# un parámetro SecureString de AWS Systems Manager Parameter Store bajo
# /centinela/prod/<NOMBRE>. El script deploy/aws/cargar_secretos.sh las
# baja a /opt/centinela/.env (permisos 600) al arrancar la instancia.
# =====================================================================

# --- Dominio y HTTPS (Caddy) ---
DOMINIO=54-12-34-56.sslip.io            # o tu dominio: centinela.midominio.pe
ACME_EMAIL=tu-correo@dominio.com        # avisos de Let's Encrypt
AWS_REGION=us-east-1

# --- Django ---
DJANGO_SECRET_KEY=<50+ caracteres aleatorios: python -c "import secrets; print(secrets.token_urlsafe(64))">
DJANGO_DEBUG=False
DJANGO_HTTPS=True
DJANGO_ALLOWED_HOSTS=54-12-34-56.sslip.io,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://54-12-34-56.sslip.io
CORS_ALLOWED_ORIGINS=
DJANGO_ADMIN_HABILITADO=False
TOKEN_TTL_HORAS=12
PSEUDONIMIZACION_CLAVE=<otra clave aleatoria distinta de la de Django>

# --- Base de datos: Amazon RDS PostgreSQL (privada, cifrada) ---
POSTGRES_DB=centinela
POSTGRES_USER=centinela
POSTGRES_PASSWORD=<clave del usuario centinela (no la del usuario maestro de RDS)>
POSTGRES_HOST=centinela-db.xxxxxxxx.us-east-1.rds.amazonaws.com
POSTGRES_PORT=5432
POSTGRES_SSLMODE=verify-full
POSTGRES_SSLROOTCERT=/etc/ssl/rds/global-bundle.pem

# --- Archivos: S3 privado y cifrado (evidencias y reportes) ---
AWS_STORAGE_BUCKET_NAME=centinela-salud-evidencias-<sufijo-unico>
AWS_S3_SSE=aws:kms

# --- Correo (opcional): Amazon SES por SMTP ---
EMAIL_HOST=email-smtp.us-east-1.amazonaws.com
EMAIL_PORT=587
EMAIL_HOST_USER=<usuario SMTP de SES>
EMAIL_HOST_PASSWORD=<clave SMTP de SES>
DEFAULT_FROM_EMAIL=Centinela Salud <alertas@tu-dominio-verificado>

# --- Comportamiento del agente en la nube ---
DESCUBRIMIENTO_RED_HABILITADO=False      # desde AWS no se ve la red de la clínica
INTEGRACIONES_DEMO=True                  # True mientras no haya Wazuh/OpenVAS reales (se avisa en la consola)
QWEN_PROVIDER=ninguno                    # ninguno | bedrock | ollama
QWEN_MODEL=                              # si bedrock: id del modelo Qwen en Bedrock (ver consola de Bedrock)
NVD_API_KEY=                             # opcional: clave gratuita de la NVD (más cuota)

# --- Conectores reales (cuando la clínica los entregue) ---
WAZUH_API_URL=
WAZUH_API_USER=
WAZUH_API_PASSWORD=
OPENVAS_GMP_HOST=
OPENVAS_USERNAME=
OPENVAS_PASSWORD=
KASPERSKY_API_URL=
KASPERSKY_API_TOKEN=
