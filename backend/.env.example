# Copia este archivo a .env y completa los valores reales.
# Nunca subas el .env real al repositorio.
# (Para la nube, ver deploy/env.produccion.ejemplo: allí van en Parameter Store.)

DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# PostgreSQL. Déjalas vacías (como están) para usar SQLite en desarrollo
# local; config/settings.py solo activa PostgreSQL cuando POSTGRES_DB
# tiene un valor. Ver "Pasar de SQLite a PostgreSQL" en el README.
POSTGRES_DB=
POSTGRES_USER=centinela
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Integraciones. Vacías = modo demostración (con DJANGO_DEBUG=True los
# conectores devuelven hallazgos de ejemplo). Se consideran configuradas
# solo con URL + usuario + clave.
WAZUH_API_URL=
WAZUH_API_USER=
WAZUH_API_PASSWORD=

OPENVAS_GMP_HOST=
OPENVAS_GMP_PORT=9390
OPENVAS_USERNAME=
OPENVAS_PASSWORD=

# IA generativa: ollama (Qwen en la sede), bedrock (AWS) o ninguno.
QWEN_PROVIDER=ninguno
QWEN_API_URL=http://localhost:11434
QWEN_MODEL=qwen2.5:14b

# Kaspersky (opcional)
KASPERSKY_API_URL=
KASPERSKY_API_TOKEN=

# Opcionales
# PSEUDONIMIZACION_CLAVE=      # por defecto usa DJANGO_SECRET_KEY
# NVD_API_KEY=                 # clave gratuita de la NVD (más cuota)
# TOKEN_TTL_HORAS=12
# DESCUBRIMIENTO_RED_HABILITADO=True
