# Copia este archivo a .env y completa los valores reales.
# Nunca subas el .env real al repositorio.

DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# PostgreSQL (RDS en AWS). Déjalas vacías para usar SQLite en desarrollo local.
POSTGRES_DB=centinela
POSTGRES_USER=centinela
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Integraciones (referencias; las credenciales reales van en un secret manager)
WAZUH_API_URL=https://wazuh.internal:55000
WAZUH_API_USER=
WAZUH_API_PASSWORD=

OPENVAS_GMP_HOST=openvas.internal
OPENVAS_GMP_PORT=9390
OPENVAS_USERNAME=
OPENVAS_PASSWORD=

QWEN_API_URL=http://qwen-local:11434
QWEN_MODEL=qwen2.5:14b

# Kaspersky (opcional, contemplado para una integración futura)
KASPERSKY_API_URL=
KASPERSKY_API_TOKEN=
